# Copy to frontend/.env. These values are PUBLIC (bundled into the site) - never put secrets here.
# Local dev: backend on 8001. PRODUCTION (Vercel): leave REACT_APP_BACKEND_URL UNSET so the app calls /api on the same
# domain, which frontend/vercel.json proxies to Render (keeps the admin cookie first-party).
REACT_APP_BACKEND_URL=http://localhost:8001
# reCAPTCHA v2 (checkbox) SITE key - public by design. The matching secret key belongs in backend/.env only.
REACT_APP_RECAPTCHA_SITE_KEY=
REACT_APP_SITE_URL=https://www.your-domain.com
GENERATE_SOURCEMAP=false
