# Copy to backend/.env and fill in. NEVER commit the real .env file.
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexcare
# Comma-separated frontend origins (no *), e.g. https://www.your-domain.com,https://your-domain.com
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Generate each with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
IP_HASH_SALT=

# Admin login. Prefer a bcrypt hash in production and leave ADMIN_PASSWORD empty.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Production behind the Vercel /api proxy: strict. Use "none" only if the browser calls this API directly from another site.
ADMIN_COOKIE_SAMESITE=strict

# Resend (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Google reCAPTCHA v2 "I'm not a robot" secret key (server only - never put it in the frontend)
RECAPTCHA_SECRET_KEY=
# Hostnames Google reports back after a successful check. Add localhost for local development.
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

# Optional
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
GEO_LOOKUP_ENABLED=false
